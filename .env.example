# USDC ↔ USDD Bidirectional Swap Service – example environment
# Copy this file to .env and edit the values for your setup.

# --- Solana (Required) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Path to the vault keypair (JSON array of ints)
VAULT_KEYPAIR=./vault-keypair.json
# --- The token pair you are bridging -------------------------------------------------
# This bridge is token-agnostic. Choose any Solana SPL token and any Nexus token.
# Solana side: the vault SPL token account (ATA), NOT a wallet owner address.
SOLANA_VAULT_ACCOUNT=<YOUR_VAULT_TOKEN_ACCOUNT_ADDRESS>
# Mint of the Solana-side token (mainnet USDC shown; devnet USDC is 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU)
SOLANA_TOKEN_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Display ticker and decimals for the Solana-side token
SOLANA_TOKEN_SYMBOL=USDC
SOLANA_TOKEN_DECIMALS=6
# (Legacy spellings VAULT_USDC_ACCOUNT / USDC_MINT / USDC_DECIMALS are still accepted.)
# SOL mint (change if using Devnet)
SOL_MINT=So11111111111111111111111111111111111111112
SOL_MAIN_ACCOUNT=<YOUR_SOL_MAIN_ACCOUNT_ADDRESS>


# --- Nexus (Required + Optional) ---
# Path to Nexus CLI (Linux/macOS: chmod +x ./nexus)
NEXUS_CLI_PATH=./nexus
# Multiuser mode: set to true ONLY if your nexus.conf has multiuser=1.
# On a multiuser node every finance/*, assets/*, market/* and supply/* call must carry
# session=<id>; on a single-user node the session must NOT be sent at all. The service
# adds or omits it automatically based on this flag.
NEXUS_MULTIUSER=false
# Session id from `sessions/create/local` — required when NEXUS_MULTIUSER=true.
# Treat as a credential: with the PIN it authorises spending.
NEXUS_SESSION=
# PIN for your Nexus account
NEXUS_PIN=<YOUR_NEXUS_PIN>
# USDD treasury account (token treasury) used by the service (receives USDD when minting)
NEXUS_USDD_TREASURY_ACCOUNT=<YOUR_USDD_TREASURY_ACCOUNT_ADDRESS>
# USDD local account: receives tiny USDD routes and congestion fees from refunds
NEXUS_USDD_LOCAL_ACCOUNT=<YOUR_LOCAL_USDD_ACCOUNT_ADDRESS>
# USDD quarantine account: self-owned USDD account where failed USDD refunds are quarantined
NEXUS_USDD_QUARANTINE_ACCOUNT=<YOUR_USDD_QUARANTINE_ACCOUNT_ADDRESS>
# (Optional) USDD fees account if you mint/route fees separately on Nexus
NEXUS_USDD_FEES_ACCOUNT=<YOUR_USDD_FEES_ACCOUNT_ADDRESS>
# Nexus-side token: ticker and decimals. This is the token the service mints/debits.
NEXUS_TOKEN_NAME=USDD
NEXUS_TOKEN_DECIMALS=6
# Memo prefix a depositor puts on their Solana transfer to name the Nexus destination,
# e.g. "nexus:8Cuy...". Change it to namespace your bridge.
DEPOSIT_MEMO_PREFIX=nexus:

# --- Public service identity (published in the on-chain registration asset) ---
SERVICE_PROVIDER=<your-name-or-domain>
SERVICE_VERSION=1.0.0
SERVICE_CONTACT=<https://your-site-or-contact>
# RPC host if applicable
NEXUS_RPC_HOST=http://127.0.0.1:<port>

# --- Polling & State (Optional) ---
POLL_INTERVAL=25
# Optional chain-specific poll intervals (override global if set)
# If you want faster Solana responsiveness but slower Nexus (e.g. Nexus 50s blocks), set:
# SOLANA_POLL_INTERVAL=15
# NEXUS_POLL_INTERVAL=55
SOLANA_POLL_INTERVAL=25
NEXUS_POLL_INTERVAL=55
# SQLite database for all state persistence (signatures, txids, fees, attempts)
STATE_DB_PATH=swap_service.db
MAX_ACTION_ATTEMPTS=3
ACTION_RETRY_COOLDOWN_SEC=300
REFUND_TIMEOUT_SEC=3600
STALE_DEPOSIT_QUARANTINE_SEC=86400

# --- Timeout & Hang Prevention (Optional) ---
# Solana RPC call timeout (seconds)
# Commitment for ingesting deposits and settling our own payouts. 'confirmed' is NOT
# rooted and can be reorged away after USDD has already been minted against it, leaving
# permanently unbacked supply. Keep 'finalized' unless you accept that risk.
SOLANA_DEPOSIT_COMMITMENT=finalized
# If you relax the above, deposits >= this many USDC base units still require finalization.
# 0 disables the carve-out.
SOLANA_FINALIZED_ABOVE_UNITS=0
SOLANA_RPC_TIMEOUT_SEC=8
# Individual transaction fetch timeout (seconds)
SOLANA_TX_FETCH_TIMEOUT_SEC=12
# Max time budget for Solana poller per cycle (seconds)
SOLANA_POLL_TIME_BUDGET_SEC=15
# Max transactions to fetch per Solana poll cycle
SOLANA_MAX_TX_FETCH_PER_POLL=40
# --- Optional: Helius enriched RPC ---------------------------------------------------
# Cuts Solana deposit polling from N+1 calls to 1-2 by fetching transactions with their
# memos in one request. Set either the full URL or just the key. See SETUP.md.
# HELIUS_RPC_URL=https://rpc.helius.xyz/?api-key=YOUR_KEY
# HELIUS_API_KEY=YOUR_KEY
# Max deposits fetched per Helius poll (default 200)
# POLL_HELIUS_LIMIT=200

# Nexus CLI command timeout (seconds)
NEXUS_CLI_TIMEOUT_SEC=20
# Max time budget for Nexus poller per cycle (seconds)
NEXUS_POLL_TIME_BUDGET_SEC=15
# Max time for draining queued Nexus->Solana entries per cycle (seconds).
# UNPROCESSED_PROCESS_BUDGET_SEC is accepted as a legacy alias.
UNPROCESSED_TXIDS_PROCESS_BUDGET_SEC=30
# Max time for metrics collection (seconds)
METRICS_BUDGET_SEC=5
# How often to show metrics (seconds)
METRICS_INTERVAL_SEC=30
# Age threshold for stale rows to be quarantined/manual review (seconds)
STALE_ROW_SEC=86400

# --- Fees & policy ---
# FLAT_FEE_USDC applies to the USDD->USDC direction (deducted from the USDC output).
# The names follow the OUTPUT token, not the input - see CONFIG.md.
FLAT_FEE_USDC=0.5
# Threshold for tiny USDD deposits; tiny USDD goes to NEXUS_USDD_LOCAL_ACCOUNT
FLAT_FEE_USDD=0.1
# Single dynamic fee (bps) applied on successful swaps (both directions). Set to 0 to disable.
DYNAMIC_FEE_BPS=10
# Minimum swap amounts, in the bridged token. Leave BLANK to derive them from the flat
# fee (2x), which is correct for any denomination — a fixed "0.2" would mean 0.2 BTC on a
# wBTC bridge. Explicit values are still floored at 2x the fee.
MIN_DEPOSIT_USDC=
# Must stay ABOVE the USDD->USDC fee (FLAT_FEE_USDC + dynamic) or the swap nets <= 0.
# Keep README.md and CONFIG.md in sync with this value.
MIN_CREDIT_USDD=
# Below this, credits are ignored entirely as spam. Between this and MIN_CREDIT_USDD
# they are recorded and booked as fees (never silently dropped).
DUST_CREDIT_USDD=

# Nexus congestion fee (USDD token units) subtracted from USDD refunds on the Nexus->Solana path
# This covers on-chain execution costs for rejected/invalid deposits (e.g., invalid Solana address)
NEXUS_CONGESTION_FEE_USDD=0.001

# --- Fee processing / maintenance ---
# Enable optional DEX SOL top-ups and backing checks (disabled by default)
FEE_CONVERSION_ENABLED=false
# Minimum USDC base units before attempting conversions (e.g., 100000 = 0.1 USDC when USDC_DECIMALS=6)
FEE_CONVERSION_MIN_USDC=100000
# SOL lamports thresholds (min to trigger buy; target to top up to)
SOL_TOPUP_MIN_LAMPORTS=5000000
SOL_TOPUP_TARGET_LAMPORTS=10000000
# Optional: minimum NXS units before attempting NXS top-ups (placeholder)
NEXUS_NXS_TOPUP_MIN=0
# Backing safety thresholds
BACKING_DEFICIT_BPS_ALERT=10
BACKING_DEFICIT_PAUSE_PCT=90
# Periodic reconcile: (optional) mint USDD to local account to bring backing to 1:1
BACKING_RECONCILE_INTERVAL_SEC=3600
# If neither SOL nor NXS are below minimum and backing ratio >= 1.05, mint USDD from treasury to local
# to bring ratio back to 1 only when vault USDC balance is above this threshold (in USDC units)
BACKING_SURPLUS_MINT_THRESHOLD_USDC=20

# --- Optional on-chain heartbeat ---
HEARTBEAT_ENABLED=true
# If you created a heartbeat asset, set its address here; leave blank to disable
NEXUS_HEARTBEAT_ASSET_ADDRESS=
# Asset name for the heartbeat asset (e.g., "USDD Heartbeat")
NEXUS_HEARTBEAT_ASSET_NAME=<YOUR_HEARTBEAT_ASSET_NAME>
# Free if >= 10 seconds between updates
HEARTBEAT_MIN_INTERVAL_SEC=300
## Optional heartbeat waterline fields (used by pollers to bound reprocessing)
HEARTBEAT_WATERLINE_ENABLED=true
HEARTBEAT_WATERLINE_SOLANA_FIELD=last_safe_timestamp_solana
# Must match the field on the heartbeat asset (format=basic locks fields at creation).
HEARTBEAT_WATERLINE_NEXUS_FIELD=last_safe_timestamp_nexus
HEARTBEAT_WATERLINE_SAFETY_SEC=120

# --- Confirmation / aging thresholds (Optional) ---
# Max seconds to wait for confirming outbound USDD->USDC USDC transfers before refunding
USDC_CONFIRM_TIMEOUT_SEC=600

# --- Production admission control -----------------------------------------------------
# Keep false for local development and devnet/testnet. Setting this true makes startup
# reject disabled exposure caps or missing alert routing before opening the state database.
SWAP_PRODUCTION_MODE=false

# --- Exposure caps (Optional in development; REQUIRED when SWAP_PRODUCTION_MODE=true) ---
# Largest single swap accepted in each direction; larger amounts are refunded.
MAX_SWAP_USDC=0
MAX_SWAP_USDD=0
# Rolling 24h ceiling on total outbound USDC, enforced at the single send choke point.
DAILY_PAYOUT_CAP_USDC=0

# --- Alerting (Optional but strongly recommended) ---
# Without a channel, backing-deficit pauses, unbacked-mint discrepancies and halted
# pollers are only visible on stdout.
ALERT_WEBHOOK_URL=
ALERT_COMMAND=
ALERT_MIN_INTERVAL_SEC=300

# --- Operator dashboard (read-only web UI; separate process) ---
# Non-loopback binds REQUIRE a token; the dashboard refuses to start without one.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=

# --- Quarantine (Optional) ---
# Self-owned USDC token account used to quarantine amounts from failed refunds so they don't affect backing ratio
USDC_QUARANTINE_ACCOUNT=
