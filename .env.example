# Configurable Solana/Nexus single-pair swap service — example environment
# Copy to .env and replace placeholders for exactly one configured pair.
# Historical USDC/USDD values mentioned below are defaults or compatibility spellings,
# not a claim of universal pair support. See CONFIG.md before operating.

# --- Solana: required identity and custody ------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VAULT_KEYPAIR=./vault-keypair.json
SOL_MAIN_ACCOUNT=<SOLANA_VAULT_OWNER_PUBKEY>
# Classic SPL Token Program account for SOLANA_TOKEN_MINT, not the owner wallet.
SOLANA_VAULT_ACCOUNT=<SOLANA_VAULT_TOKEN_ACCOUNT>
SOLANA_TOKEN_MINT=<SOLANA_CLASSIC_SPL_MINT>
# Display only. Code defaults to USDC when omitted; set this to the configured token.
SOLANA_TOKEN_SYMBOL=<SOLANA_TOKEN_SYMBOL>
SOLANA_TOKEN_DECIMALS=6
# Legacy aliases accepted with conflict rejection when both spellings are non-empty:
# VAULT_USDC_ACCOUNT, USDC_MINT, USDC_DECIMALS

# Optional Helius enriched Solana RPC. Full URL wins over the key.
# HELIUS_RPC_URL=https://rpc.helius.xyz/?api-key=<HELIUS_API_KEY>
# HELIUS_API_KEY=<HELIUS_API_KEY>

# --- Nexus: required identity and custody ------------------------------------------
# Local/development compatibility transport. Production must use the HTTPS settings below.
NEXUS_CLI_PATH=./nexus
NEXUS_PIN=<NEXUS_PROFILE_PIN>
NEXUS_TREASURY_ACCOUNT=<NEXUS_TOKEN_TREASURY_ACCOUNT>
# Display/API token name. Code defaults to USDD when omitted; set the configured token.
NEXUS_TOKEN_NAME=<NEXUS_TOKEN_NAME>
# Immutable identity returned by a trusted finance/get/token lookup. Required in production.
NEXUS_TOKEN_REGISTER_ADDRESS=<NEXUS_TOKEN_REGISTER_ADDRESS>
NEXUS_TOKEN_DECIMALS=6
# Legacy aliases accepted with conflict rejection:
# NEXUS_USDD_TREASURY_ACCOUNT, USDD_DECIMALS

# Optional account settings for the configured Nexus token.
# Production requires the quarantine destination, but the service loop never moves funds
# there automatically; movement uses the separately authorized durable-intent CLI.
NEXUS_QUARANTINE_ACCOUNT=<NEXUS_TOKEN_QUARANTINE_ACCOUNT>
NEXUS_FEE_ACCOUNT=
# Literal legacy-named setting with no generic alias; used by local-balance helpers only.
# It does not enable automatic Nexus refund or quarantine routing.
NEXUS_USDD_LOCAL_ACCOUNT=
# Legacy aliases accepted with conflict rejection:
# NEXUS_USDD_QUARANTINE_ACCOUNT, NEXUS_USDD_FEES_ACCOUNT

# Memo prefix on Solana deposits before the Nexus destination account.
DEPOSIT_MEMO_PREFIX=nexus:

# Production Nexus transport. In nexus.conf use authenticated TLS; these are mandatory
# when SWAP_PRODUCTION_MODE=true. URL userinfo, query strings and fragments are rejected.
NEXUS_API_URL=
NEXUS_API_USER=
NEXUS_API_PASSWORD=
# Set true only when nexus.conf has multiuser=1. The service then adds NEXUS_SESSION to
# session-scoped requests. In single-user mode it deliberately sends no session.
NEXUS_MULTIUSER=false
NEXUS_SESSION=
# Parsed compatibility setting; the active transport is selected above.
NEXUS_RPC_HOST=http://127.0.0.1:<PORT>

# --- Public v1 service identity -----------------------------------------------------
SERVICE_PROVIDER=<OPERATOR_NAME_OR_DOMAIN>
SERVICE_VERSION=1.0.0
SERVICE_CONTACT=<OPERATOR_CONTACT_URL_OR_HANDLE>

# --- Optional public Nexus receipt assets -------------------------------------------
# Named asset creation spends operator NXS. This development/test-only extension is
# default-disabled. It has a local budget ledger, but production admission rejects it
# until target-node acceptance and the receipt-capable registration migration pass.
NEXUS_SWAP_RECEIPTS_ENABLED=false
NEXUS_SWAP_RECEIPT_TIMEOUT_SEC=20
# Raw NXS base units, not units of NEXUS_TOKEN_NAME. A receipt create is attempted only
# after atomically reserving EXPECTED_COST from this lifetime budget. Keep both zero
# unless a reviewed development/test deployment has an explicit NXS spend allowance.
NEXUS_SWAP_RECEIPT_EXPECTED_COST_NXS_UNITS=0
NEXUS_SWAP_RECEIPT_BUDGET_NXS_UNITS=0

# --- Polling and state --------------------------------------------------------------
# Template operating cadence retained from the prior example; config.py's unset global
# default is 10 seconds. Chain-specific values override POLL_INTERVAL.
POLL_INTERVAL=25
SOLANA_POLL_INTERVAL=25
NEXUS_POLL_INTERVAL=55
STATE_DB_PATH=swap_service.db
MAX_ACTION_ATTEMPTS=3
ACTION_RETRY_COOLDOWN_SEC=300
REFUND_TIMEOUT_SEC=3600
STALE_DEPOSIT_QUARANTINE_SEC=86400

# --- Timeouts, budgets and finality -------------------------------------------------
SOLANA_DEPOSIT_COMMITMENT=finalized
# Raw Solana base units. If the commitment is relaxed, amounts at/above this still require
# finalization. Zero disables the carve-out; it does not change the commitment above.
SOLANA_FINALIZED_ABOVE_UNITS=0
SOLANA_RPC_TIMEOUT_SEC=8
SOLANA_TX_FETCH_TIMEOUT_SEC=12
SOLANA_POLL_TIME_BUDGET_SEC=15
# Template value retained; config.py's unset default is 120.
SOLANA_MAX_TX_FETCH_PER_POLL=40
NEXUS_CLI_TIMEOUT_SEC=20
NEXUS_POLL_TIME_BUDGET_SEC=15
# Must be a positive integer; config import rejects zero, negative and non-integer values.
NEXUS_TRANSFER_MIN_CONFIRMATIONS=10
UNPROCESSED_TXIDS_PROCESS_BUDGET_SEC=30
# Legacy fallback: UNPROCESSED_PROCESS_BUDGET_SEC
METRICS_BUDGET_SEC=5
METRICS_INTERVAL_SEC=30
STALE_ROW_SEC=86400
SOLANA_CONFIRM_TIMEOUT_SEC=600
# Legacy fallback: USDC_CONFIRM_TIMEOUT_SEC

# --- Canonical direction-named fees and thresholds ---------------------------------
# Whole output-token units. Values must be exactly representable at configured precision.
# Historical defaults are 0.5 to Solana and 0.1 to Nexus; they are not denomination advice.
FEE_FLAT_TO_SOLANA=0.5
FEE_FLAT_TO_NEXUS=0.1
# Solana-side refund fee was historically coupled to FLAT_FEE_USDD; explicit canonical
# configuration keeps the same numerical policy while making the chain domain clear.
FEE_REFUND_SOLANA=0.1
FEE_BPS=10
# Legacy aliases: FLAT_FEE_USDC, FLAT_FEE_USDD, DYNAMIC_FEE_BPS.
# Do not set a canonical key and its legacy alias to different strings.

# Leave blank to derive safe denomination-aware defaults from the relevant flat fee.
# Explicit minimums below the code floor are raised to twice that fee.
MIN_DEPOSIT_SOLANA_TOKEN=
MIN_CREDIT_NEXUS_TOKEN=
DUST_CREDIT_NEXUS_TOKEN=
# Legacy fallbacks: MIN_DEPOSIT_USDC, MIN_CREDIT_USDD, DUST_CREDIT_USDD.

# Reserved canonical Nexus disposition fee. No automatic Nexus refund/quarantine debit
# applies this value; operator intents remain separate and explicitly authorized.
FEE_NEXUS_DISPOSITION=0
# Legacy alias: NEXUS_CONGESTION_FEE_USDD

# --- Backing safety -----------------------------------------------------------------
# Surplus is alert-only; there is no automatic DEX conversion or Nexus mint/rebalance.
BACKING_DEFICIT_BPS_ALERT=10
BACKING_DEFICIT_PAUSE_PCT=90
BACKING_RECONCILE_INTERVAL_SEC=3600
# Literal legacy-named active key in configured Solana token units; no generic alias yet.
BACKING_SURPLUS_MINT_THRESHOLD_USDC=20

# --- Current name-addressed v1 heartbeat and recovery -------------------------------
# HEARTBEAT_ENABLED is consulted by service-record publication/validation, but setting it
# false does not disable startup recovery or live polling's name-addressed asset dependency.
HEARTBEAT_ENABLED=true
NEXUS_HEARTBEAT_ASSET_NAME=<V1_HEARTBEAT_ASSET_NAME>
# Recorded for reference only; current runtime lookup is by NAME, not this address.
NEXUS_HEARTBEAT_ASSET_ADDRESS=
HEARTBEAT_MIN_INTERVAL_SEC=300
HEARTBEAT_WATERLINE_ENABLED=true
HEARTBEAT_WATERLINE_SOLANA_FIELD=last_safe_timestamp_solana
HEARTBEAT_WATERLINE_NEXUS_FIELD=last_safe_timestamp_nexus
HEARTBEAT_WATERLINE_SAFETY_SEC=120
# The asset's top-level waterline values themselves are not env settings. Establish reviewed,
# positive checkpoints on-chain; never initialize to the current time merely to skip history.

# --- Production admission -----------------------------------------------------------
# Strict boolean: only 1/true/yes/on and 0/false/no/off are accepted.
SWAP_PRODUCTION_MODE=false
# These remain literal legacy-named active keys; generic env aliases do not exist yet.
# Zero disables them in development but causes production startup refusal.
# Known gap: the daily check covers refund/quarantine sends, not the main Nexus-to-Solana
# payout helper. A positive value does not repair that bypass; see docs/SECURITY.md.
MAX_SWAP_USDC=0
MAX_SWAP_USDD=0
DAILY_PAYOUT_CAP_USDC=0

# Production also requires both quarantine accounts, immutable Nexus token identity,
# credential-safe HTTPS transport, and at least one tested alert route.
SOLANA_QUARANTINE_ACCOUNT=<SOLANA_CONFIGURED_MINT_QUARANTINE_ACCOUNT>
SOLANA_FEE_ACCOUNT=
# Legacy aliases: USDC_QUARANTINE_ACCOUNT, USDC_FEES_ACCOUNT
ALERT_WEBHOOK_URL=
ALERT_COMMAND=
ALERT_MIN_INTERVAL_SEC=300

# --- Read-only dashboard (separate process) -----------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
