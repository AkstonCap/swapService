+def test_conflicting_or_independent_vault_creation_evidence_is_rejected(conflict):
+    tx = full_transaction(252, 300)
+    tx["meta"]["preTokenBalances"] = []
+    ata = {
+        "program": "spl-associated-token-account",
+        "parsed": {"type": "create", "info": {
